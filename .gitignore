# ===== 环境与密钥 =====
.env
*.env.local
.venv/
venv/
env/

# ===== Python =====
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.mypy_cache/
.ipynb_checkpoints/

# ===== 数据产物（体积大 / 可由 pipeline 重建） =====
data/raw/html/*
!data/raw/html/.gitkeep
data/raw/images/*
!data/raw/images/.gitkeep
# 采集清单与 OCR 缓存都是生成物：清单随每次采集变化，缓存按图片哈希增长
data/raw/manifest.jsonl
data/raw/ocr/
data/processed/*.csv
data/processed/*.xlsx
data/processed/*.json
# 登录会话（StorageState）：含 Cookie，**绝不能提交**
data/.session.json
data/.session*.json
# 成果看板：由 scripts/make_report.py 从真实数据生成，不入库（含真实标题与链接）
data/processed/*.html
data/*.db
data/*.sqlite
data/*.sqlite3
data/logs/
!data/logs/.gitkeep

# ===== 日志与临时文件 =====
*.log
*.tmp
tmp/

# ===== 编辑器 / 操作系统 =====
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini

# ===== Jupyter Notebook =====
docs/overview.md
