# ============================================================
# 复制本文件为 .env 后填写真实值；.env 已被 .gitignore 忽略
#   cp .env.example .env
#
# 这里放的是**凭据**（学号/密码/Cookie/API Key）与环境相关的值；
# 其余运行参数一律写在 config/config.yaml 里。
# 优先级：.env > config/config.yaml > 代码默认值
# ============================================================

# ---------- 门户与登录（合规红线：只用本人账号） ----------
# 门户 BASE（也可写在 config.yaml 的 portal.base_url，.env 优先级更高）
PORTAL_BASE_URL=
# 本人学号
AUTH_STUDENT_ID=
# 本人密码（仅本地留存，禁止提交、禁止外传）
AUTH_PASSWORD=
# 手动 Cookie 登录方式时填写（auth.method=cookie）：从浏览器开发者工具复制
AUTH_COOKIE=

# ---------- 请求 ----------
# 需要代理时填写，如 http://127.0.0.1:7897；留空表示直连
CRAWLER_PROXY=

# ---------- 二级抽取：LLM ----------
# true/false 覆盖 config.yaml 的 llm.enabled
LLM_ENABLED=false
LLM_API_KEY=
# OpenAI 兼容接口示例：https://api.openai.com/v1
# 本地 ollama 示例：    http://localhost:11434/v1
LLM_BASE_URL=
LLM_MODEL=

# ---------- OCR ----------
OCR_ENABLED=false
# Linux 下一般为 /usr/bin/tesseract；留空则使用系统 PATH
TESSERACT_CMD=

# ---------- 存储与日志 ----------
DB_PATH=data/employment.db
LOG_LEVEL=INFO
