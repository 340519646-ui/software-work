# ============================================================
# 复制本文件为 .env 后填写真实值；.env 已被 .gitignore 忽略
#   cp .env.example .env
# ============================================================

# ===== 大模型 API（用于解析增强，可留空以关闭 LLM 抽取） =====
LLM_ENABLED=false
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=60

# ===== 数据库 =====
# 相对路径以项目根目录为基准
DATABASE_URL=sqlite:///data/employment.db

# ===== 爬虫 =====
CRAWLER_USER_AGENT=Mozilla/5.0 (compatible; EmploymentDataPipeline/1.0)
CRAWLER_MAX_PAGES=100
CRAWLER_REQUEST_DELAY=1.5
CRAWLER_TIMEOUT=20
CRAWLER_MAX_RETRIES=3
# 需要 HTTP 代理时填写，如 http://127.0.0.1:7897 ；留空表示直连
CRAWLER_PROXY=

# ===== OCR（图片型页面 / 附件识别） =====
OCR_ENABLED=false
OCR_LANG=chi_sim+eng
# Linux 下一般为 /usr/bin/tesseract
TESSERACT_CMD=

# ===== 运行环境 =====
LOG_LEVEL=INFO
LOG_DIR=data/logs
RANDOM_SEED=42
